# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ami_infracon

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration
# All four secrets below must be unique!
JWT_SECRET=your_user_access_jwt_secret_here
JWT_REFRESH_SECRET=your_user_refresh_jwt_secret_here
ADMIN_JWT_SECRET=your_admin_access_jwt_secret_here
ADMIN_JWT_REFRESH_SECRET=your_admin_refresh_jwt_secret_here
ADMIN_JWT_EXPIRES=15m

# Google OAuth (Optional)
CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Service Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# Vite (Frontend) — must be prefixed with VITE_ to be exposed to the browser
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com