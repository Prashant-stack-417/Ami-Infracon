{
  "name": "ami-infracon-backend",
  "version": "1.0.0",
  "description": "Backend API for Ami Infracon LLP",
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "authentication"
  ],
  "license": "ISC",
  "author": "Ami Infracon LLP",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --env-file=../.env --watch src/index.js",
    "start": "node --env-file=../.env src/index.js",
    "create-superadmin": "node --env-file=../.env src/scripts/createSuperAdmin.js",
    "generate-images": "node src/scripts/generateProductImages.js",
    "seed": "node --env-file=../.env src/scripts/seedProducts.js",
    "seed-blogs": "node --env-file=../.env src/scripts/seedBlogs.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.21.0",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
