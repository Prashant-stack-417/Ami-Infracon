{
  "name": "ami-infracon-backend",
  "version": "1.0.0",
  "description": "Backend API for Ami Infracon LLP",
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "authentication"
  ],
  "license": "ISC",
  "author": "Ami Infracon LLP",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --env-file=../.env --watch src/index.js",
    "start": "node --env-file=../.env src/index.js",
    "create-superadmin": "node --env-file=../.env src/scripts/createSuperAdmin.js",
    "generate-images": "node src/scripts/generateProductImages.js",
    "seed": "node --env-file=../.env src/scripts/seedProducts.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-rate-shield": "^1.0.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.3.0",
    "image-size": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.21.0",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
